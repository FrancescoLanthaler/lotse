<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Makes Documents (hall-test CSVs) visible in
	     Finder and the Files app; this key has no INFOPLIST_KEY_ build setting. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- SPEC §3 "Background operation": beacon, speech, GPS and prompts keep running with the
	     screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
</dict>
</plist>
